--!strict

local fs = require "@std/fs"
local process = require "@lute/process"

local PREFIX = "COMPOSE-VERIFY"

local function gitValue(arguments: { string }, fallback: string): string
	local command = { "git" }
	for _, argument in arguments do
		table.insert(command, argument)
	end
	local result = process.run(command)
	if not result.ok then
		return fallback
	end
	return (result.stdout:gsub("%s+$", ""))
end

local function escape(text: string): string
	local escaped = string.gsub(text, "&", "&amp;")
	escaped = string.gsub(escaped, "<", "&lt;")
	escaped = string.gsub(escaped, ">", "&gt;")

	escaped = string.gsub(escaped, "[%z\1-\8\11\12\14-\31]", "")
	return escaped
end

local function moduleScript(referent: string, name: string, source: string): string
	return table.concat({
		('	<Item class="ModuleScript" referent="%s">'):format(referent),
		"		<Properties>",
		('			<string name="Name">%s</string>'):format(escape(name)),
		('			<ProtectedString name="Source">%s</ProtectedString>'):format(escape(source)),
		"		</Properties>",
		"	</Item>",
	}, "\n")
end

local function main(): number
	local out = "build/ComposeVerify.rbxmx"
	local args = process.args
	local index = 2
	while index <= #args do
		if args[index] == "--out" then
			index += 1
			out = args[index]
		else
			error(("make-verification-plugin: unrecognised argument %q"):format(tostring(args[index])), 0)
		end
		index += 1
	end

	local bundlePath = "build/compose.bundle.luau"
	local bundled = process.run {
		"lute",
		"run",
		"tools/bundle.luau",
		"--entry",
		"src/core",
		"--entry",
		"src/roblox",
		"--name",
		"Compose",
		"--out",
		bundlePath,
		"--strip-comments",
	}
	if not bundled.ok then
		print("make-verification-plugin: bundling failed\n" .. bundled.stderr)
		return 1
	end

	local bundle = fs.readFileToString(bundlePath)
	local checks = fs.readFileToString "verification/roblox/checks.luau"
	local sourceCommit = gitValue({ "rev-parse", "HEAD" }, "unknown")
	local sourceTree = gitValue({ "rev-parse", "HEAD^{tree}" }, "unknown")
	local sourceDirty = gitValue({ "status", "--porcelain" }, "unknown") ~= ""
	local identityPath = "build/ComposeVerificationIdentity.luau"
	fs.writeStringToFile(
		identityPath,
		([[return table.freeze {
	sourceCommit = %q,
	sourceTree = %q,
	sourceDirty = %s,
}
]]):format(sourceCommit, sourceTree, tostring(sourceDirty))
	)

	local runner = table.concat({
		"--!strict",
		"-- Generated by tools/make-verification-plugin.luau. Do not edit.",
		"",
		"local bundle = require(script.ComposeBundle)",
		"local Checks = require(script.ComposeChecks)",
		"",
		"-- One bundle, one registry: the core the adapter is bound to is the core below.",
		'local Compose = bundle["src/core"]',
		'local ComposeRoblox = bundle["src/roblox"]',
		"",
		"task.defer(function()",
		'	local container = Instance.new("Folder")',
		'	container.Name = "ComposeVerification"',
		"	container.Parent = workspace",
		"",
		('	print("%s|begin")'):format(PREFIX),
		('	print("%s|env|sourceCommit|%s")'):format(PREFIX, sourceCommit),
		('	print("%s|env|sourceTree|%s")'):format(PREFIX, sourceTree),
		('	print("%s|env|sourceDirty|%s")'):format(PREFIX, tostring(sourceDirty)),
		"	local ok, summary = pcall(Checks.run, Compose, ComposeRoblox, container)",
		"	if not ok then",
		('		print(("%s|fatal|" .. tostring(summary)):gsub("\\n", " "))'):format(PREFIX),
		('		print("%s|end")'):format(PREFIX),
		"		container:Destroy()",
		"		return",
		"	end",
		"",
		"	for key, value in summary.environment do",
		('		print(("%s|env|%%s|%%s"):format(key, tostring(value)))'):format(PREFIX),
		"	end",
		"	for _, result in summary.results do",
		('		print(("%s|%%s|%%s|%%s"):format('):format(PREFIX),
		'			if result.passed then "pass" else "FAIL",',
		"			result.name,",
		'			(result.detail:gsub("\\n", " "))',
		"		))",
		"	end",
		('	print(("%s|total|%%d passed|%%d failed"):format(summary.passed, summary.failed))'):format(PREFIX),
		('	print("%s|end")'):format(PREFIX),
		"",
		"	container:Destroy()",
		"end)",
	}, "\n")

	local xml = table.concat({
		'<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" '
			.. 'xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" '
			.. 'xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">',
		'	<Item class="Script" referent="RBXVERIFY0">',
		"		<Properties>",
		'			<string name="Name">ComposeVerify</string>',
		('			<ProtectedString name="Source">%s</ProtectedString>'):format(escape(runner)),
		"		</Properties>",
		moduleScript("RBXVERIFY1", "ComposeBundle", bundle),
		moduleScript("RBXVERIFY2", "ComposeChecks", checks),
		"	</Item>",
		"</roblox>",
		"",
	}, "\n")

	local directory = string.match(out, "^(.*)/[^/]+$")
	if directory ~= nil and not fs.exists(directory) then
		process.run { "mkdir", "-p", directory }
	end
	fs.writeStringToFile(out, xml)

	print(("make-verification-plugin: wrote %s (%d bytes)"):format(out, #xml))
	print(("make-verification-plugin: wrote %s"):format(identityPath))
	print "  install: copy it into ~/Documents/Roblox/Plugins/ and restart Studio"
	print(("  results: lines prefixed %s| in the Studio output"):format(PREFIX))
	return 0
end

local code = main()
if code ~= 0 then
	process.exit(code)
end
return nil
